# Telegram Bot Configuration
# Get these from @BotFather on Telegram (see TELEGRAM_SCANNER_README.md for details)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Scanner Filter Parameters
# RSI: Relative Strength Index (0-100)
# - Default: 35-75 (oversold to slightly overbought)
# - Lower range: 30-70 (more relaxed)
# - Tighter range: 40-65 (stricter)
MIN_RSI=35
MAX_RSI=75

# ADX: Average Directional Index (0-100)
# - Measures trend strength
# - 20+: Moderate trend
# - 25+: Strong trend
# - 30+: Very strong trend
MIN_ADX=20

# Volume Ratio
# - Ratio of today's volume to 20-day average
# - 1.2: 20% above average (default)
# - 1.5: 50% above average (stricter)
# - 1.0: Any volume (relaxed)
MIN_VOLUME_RATIO=1.2

# Minimum results threshold
# - Only send notification if at least this many stocks qualify
# - Prevents spam when market is quiet
MIN_RESULTS=3

# Optional: Maximum stocks to analyze
# - Useful for limiting analysis time
# - Default: analyze all
MAX_STOCKS=50
