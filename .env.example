# Telegram Bot Configuration
# Instructions: Create a bot with @BotFather and get your chat ID from @RawDataBot

# Your Telegram Bot Token (from @BotFather)
# Example: 123456789:ABCdef-_ghiJKL_MnoPQ-RSTUVWXYZ_1Ab
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID (from @RawDataBot)
# Example: 987654321
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Scanner Configuration
# Maximum stocks to scan (defaults to all 208)
# MAX_STOCKS=50

# Optional: Minimum volume ratio filter (default: 1.2)
# MIN_VOLUME_RATIO=1.5
