# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram: https://telegram.me/botfather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID from @userinfobot on Telegram or by messaging your bot and checking logs
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: NSE Data source (for future enhancement)
# NSE_API_KEY=your_nse_api_key_here
