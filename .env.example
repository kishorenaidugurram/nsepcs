# Telegram Configuration
# Get these from @BotFather (token) and @userinfobot (chat_id) on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_here_from_userinfobot

# Optional: Analysis parameters
# (If not set, defaults are used: RSI 30-70, ADX 20+, Volume 1.5x, SMA support enabled)
RSI_MIN=30
RSI_MAX=70
ADX_MIN=20
VOLUME_RATIO=1.5
